# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=
# Brain, model, prompts, turn cap, token limit, and log window: config/pipeline.toml
# Uncomment to override that file for one run:
# BRAIN=claude
# CLAUDE_MODEL=sonnet
# Set to 1 to append every brain call to data/brain-debug.json
BRAIN_DEBUG=
LOGS_ADAPTER=fixture
# When the logs tunnel is up: LOGS_ADAPTER=mcp and LOGS_MCP_URL below.
LOGS_MCP_URL=http://127.0.0.1:8000/mcp
TELEMETRY_ADAPTER=fixture
GIT_ADAPTER=fixture
GITHUB_ADAPTER=fixture
GITHUB_MCP_URL=http://127.0.0.1:8001/mcp
